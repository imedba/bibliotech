{% extends 'base.html.twig' %}

{% block title %}Hello CatalogueController!{% endblock %}

{% block body %}

<main class="conteneur">

        <nav class="fil-ariane">
            <a href="#">Catalogue</a>
            <span>›</span>
            <a href="#">Roman</a>
            <span>›</span>
            <span class="fil-actuel">Germinal</span>
        </nav>

        <section class="fiche">

            <div class="fiche-couverture">
                <img src="https://placehold.co/400x600?text=Germinal" alt="Germinal">
            </div>

            <div class="fiche-details">
                <span class="genre">{{livre.genre}}</span>
                <h1 class="fiche-titre">{{livre.titre}}</h1>
                <p class="fiche-auteur">de <strong>{{livre.auteur}}</strong></p>

                <p class="fiche-resume">
                    {{livre.resume}}
                </p>

                <div class="fiche-infos">
                    <div class="info">
                        <span class="info-label">Parution</span>
                        <span class="info-valeur">{{livre.annee}}</span>
                    </div>
                    <div class="info">
                        <span class="info-label">Exemplaires</span>
                        <span class="info-valeur">{{livre.exemplaires}}</span>
                    </div>
                    <div class="info">
                        <span class="info-label">Emprunts</span>
                        <span class="info-valeur">{{livre.getNombreEmprunts()}}</span>
                    </div>
                </div>

                <p class="dispo dispo-ok">{{livre.getExemplairesDisponibles()}} exemplaire disponible sur {{livre.getNombreEmprunts()}}</p>

                <div class="fiche-action">
                    <button type="button" class="bouton bouton-grand">Réserver ce livre</button>
                </div>
            </div>

        </section>

        <section class="section">
            <h2 class="section-titre">Derniers emprunts</h2>

            <table class="tableau">
                <thead>
                    <tr>
                        <th>Adhérent</th>
                        <th>Emprunté le</th>
                        <th>Ville</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for emprunt in derniersEmprunts %}
                    <tr>
                        <td>{{emprunt.adherent.nom}}</td>
                        <td>{{emprunt.dateEmprunt|date("d/m/Y")}}</td>
                        <td>{{emprunt.adherent.ville}}</td>
                        {% if emprunt.dateRetour == null %}
                            <td><span class="statut statut-en-cours">En cours</span></td>
                        {% else %}
                            <td><span class="statut statut-rendu">Rendu</span></td>
                        {% endif %}

                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>

        <section class="section">
            <h2 class="section-titre">Du même genre</h2>

            <div class="grille">
                {% for memeGenre in memeGenres %}
                    <article class="carte">
                        <a href="#" class="carte-couverture">
                            <img src="https://placehold.co/400x600?text=L%27%C3%89tranger" alt="L'Étranger">
                            <span class="badge badge-indisponible">Indisponible</span>
                        </a>
                        <div class="carte-contenu">
                            <span class="genre">{{memeGenre.genre}}</span>
                            <h2 class="carte-titre">{{ memeGenre.titre }}</h2>
                            <p class="carte-auteur">{{ memeGenre.auteur }}</p>
                            <div class="carte-bas">
                                <span class="carte-annee">{{ memeGenre.annee }}</span>
                                <a href="#" class="bouton bouton-petit">Voir</a>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </section>

    </main>

{% endblock %}
