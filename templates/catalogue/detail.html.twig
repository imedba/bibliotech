{% extends 'base.html.twig' %}

{% block title %}Hello CatalogueController!{% endblock %}

{% block body %}

<main class="conteneur">

        <nav class="fil-ariane">
            <a href="#">Catalogue</a>
            <span>›</span>
            <a href="#">Roman</a>
            <span>›</span>
            <span class="fil-actuel">Germinal</span>
        </nav>

        <section class="fiche">

            <div class="fiche-couverture">
                <img src="https://placehold.co/400x600?text=Germinal" alt="Germinal">
            </div>

            <div class="fiche-details">
                <span class="genre">{{livre.genre}}</span>
                <h1 class="fiche-titre">{{livre.titre}}</h1>
                <p class="fiche-auteur">de <strong>{{livre.auteur}}</strong></p>

                <p class="fiche-resume">
                    {{livre.resume}}
                </p>

                <div class="fiche-infos">
                    <div class="info">
                        <span class="info-label">Parution</span>
                        <span class="info-valeur">{{livre.annee}}</span>
                    </div>
                    <div class="info">
                        <span class="info-label">Exemplaires</span>
                        <span class="info-valeur">{{livre.exemplaires}}</span>
                    </div>
                    <div class="info">
                        <span class="info-label">Emprunts</span>
                        <span class="info-valeur">{{livre.getNombreEmprunts()}}</span>
                    </div>
                </div>

                <p class="dispo dispo-ok">{{livre.getExemplairesDisponibles()}} exemplaire disponible sur {{livre.getNombreEmprunts()}}</p>

                <div class="fiche-action">
                    <button type="button" class="bouton bouton-grand">Réserver ce livre</button>
                </div>
            </div>

        </section>

        <section class="section">
            <h2 class="section-titre">Derniers emprunts</h2>

            <table class="tableau">
                <thead>
                    <tr>
                        <th>Adhérent</th>
                        <th>Emprunté le</th>
                        <th>Ville</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Camille Laurent</td>
                        <td>02/11/2026</td>
                        <td>Lyon</td>
                        <td><span class="statut statut-en-cours">En cours</span></td>
                    </tr>
                    <tr>
                        <td>Hugo Martin</td>
                        <td>14/10/2026</td>
                        <td>Paris</td>
                        <td><span class="statut statut-en-cours">En cours</span></td>
                    </tr>
                    <tr>
                        <td>Inès Moreau</td>
                        <td>21/09/2026</td>
                        <td>Nantes</td>
                        <td><span class="statut statut-rendu">Rendu le 08/10/2026</span></td>
                    </tr>
                    <tr>
                        <td>Lucas Bernard</td>
                        <td>03/09/2026</td>
                        <td>Lille</td>
                        <td><span class="statut statut-rendu">Rendu le 19/09/2026</span></td>
                    </tr>
                    <tr>
                        <td>Sarah Lefèvre</td>
                        <td>11/08/2026</td>
                        <td>Bordeaux</td>
                        <td><span class="statut statut-rendu">Rendu le 30/08/2026</span></td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section class="section">
            <h2 class="section-titre">Du même genre</h2>

            <div class="grille">

                    <article class="carte">
                        <a href="#" class="carte-couverture">
                            <img src="https://placehold.co/400x600?text=L%27%C3%89tranger" alt="L'Étranger">
                            <span class="badge badge-indisponible">Indisponible</span>
                        </a>
                        <div class="carte-contenu">
                            <span class="genre">Roman</span>
                            <h2 class="carte-titre">L'Étranger</h2>
                            <p class="carte-auteur">Albert Camus</p>
                            <div class="carte-bas">
                                <span class="carte-annee">1942</span>
                                <a href="#" class="bouton bouton-petit">Voir</a>
                            </div>
                        </div>
                    </article>

                    <article class="carte">
                        <a href="#" class="carte-couverture">
                            <img src="https://placehold.co/400x600?text=Les+Mis%C3%A9rables" alt="Les Misérables">
                            <span class="badge badge-disponible">1 / 2 disponible</span>
                        </a>
                        <div class="carte-contenu">
                            <span class="genre">Roman</span>
                            <h2 class="carte-titre">Les Misérables</h2>
                            <p class="carte-auteur">Victor Hugo</p>
                            <div class="carte-bas">
                                <span class="carte-annee">1862</span>
                                <a href="#" class="bouton bouton-petit">Voir</a>
                            </div>
                        </div>
                    </article>

                    <article class="carte">
                        <a href="#" class="carte-couverture">
                            <img src="https://placehold.co/400x600?text=Madame+Bovary" alt="Madame Bovary">
                            <span class="badge badge-disponible">1 / 1 disponible</span>
                        </a>
                        <div class="carte-contenu">
                            <span class="genre">Roman</span>
                            <h2 class="carte-titre">Madame Bovary</h2>
                            <p class="carte-auteur">Gustave Flaubert</p>
                            <div class="carte-bas">
                                <span class="carte-annee">1857</span>
                                <a href="#" class="bouton bouton-petit">Voir</a>
                            </div>
                        </div>
                    </article>

            </div>
        </section>

    </main>

{% endblock %}
