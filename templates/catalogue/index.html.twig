{% extends 'base.html.twig' %}

{% block title %}Hello CatalogueController!{% endblock %}

{% block body %}
    <main class="conteneur">

        <section class="catalogue-entete">
            <div>
                <h1 class="page-titre">Le catalogue</h1>
                <p class="page-sous-titre">12 livres</p>
            </div>

            <form method="get" class="filtres">
                <select name="genre">
                    <option value="">Tous les genres</option>
                    {% for genre in genres %}
                    <option value="{{genre}}">{{genre}}</option>
                    {% endfor %}
                </select>

                <select name="auteur">
                    <option value="">Tous les auteurs</option>
                    {% for auteur in auteurs %}
                    <option value="{{auteur}}">{{auteur}}</option>
                    {% endfor %}
                </select>

                <select name="tri">
                    <option value="">Trier par titre</option>
                    <option value="annee_desc">Plus récents d'abord</option>
                    <option value="annee_asc">Plus anciens d'abord</option>
                </select>

                <button type="submit" class="bouton">Filtrer</button>
                <a href="#" class="lien-reset">Réinitialiser</a>
            </form>
        </section>

        <section class="grille">

            {% for livre in livres %}
                <article class="carte">
                    <a href="#" class="carte-couverture">
                        <img src="{{livre.image}}" alt="1984">
                        {% if livre.estDisponible() %}
                            <span class="badge badge-disponible">{{livre.getExemplairesDisponibles()}} / {{livre.exemplaires}} disponibles</span>
                        {% else %}
                            <span class="badge badge-indisponible">Indisponible</span>
                        {% endif %}
                    </a>
                    <div class="carte-contenu">
                        <span class="genre">{{livre.genre}}</span>
                        <h2 class="carte-titre">{{livre.titre}}</h2>
                        <p class="carte-auteur">{{livre.auteur}}</p>
                        <div class="carte-bas">
                            <span class="carte-annee">{{livre.annee}}</span>
                            <a href="#" class="bouton bouton-petit">Voir</a>
                        </div>
                    </div>
                </article>
                {% endfor %}
        </section>

    </main>
{% endblock %}
