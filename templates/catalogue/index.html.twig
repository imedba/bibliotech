{% extends 'base.html.twig' %}

{% block title %}Hello CatalogueController!{% endblock %}

{% block body %}
    <main class="conteneur">

        <section class="catalogue-entete">
            <div>
                <h1 class="page-titre">Le catalogue</h1>
                <p class="page-sous-titre">12 livres</p>
            </div>

            <form method="get" class="filtres">
                <select name="genre">
                    <option value="">Tous les genres</option>
                    <option value="Aventure">Aventure</option>
                    <option value="Policier">Policier</option>
                    <option value="Roman">Roman</option>
                    <option value="Science-fiction">Science-fiction</option>
                </select>

                <select name="auteur">
                    <option value="">Tous les auteurs</option>
                    <option value="Agatha Christie">Agatha Christie</option>
                    <option value="Albert Camus">Albert Camus</option>
                    <option value="Alexandre Dumas">Alexandre Dumas</option>
                    <option value="Arthur Conan Doyle">Arthur Conan Doyle</option>
                    <option value="Frank Herbert">Frank Herbert</option>
                    <option value="George Orwell">George Orwell</option>
                    <option value="Gustave Flaubert">Gustave Flaubert</option>
                    <option value="Isaac Asimov">Isaac Asimov</option>
                    <option value="Jules Verne">Jules Verne</option>
                    <option value="Victor Hugo">Victor Hugo</option>
                    <option value="Émile Zola">Émile Zola</option>
                </select>

                <select name="tri">
                    <option value="">Trier par titre</option>
                    <option value="annee_desc">Plus récents d'abord</option>
                    <option value="annee_asc">Plus anciens d'abord</option>
                </select>

                <button type="submit" class="bouton">Filtrer</button>
                <a href="#" class="lien-reset">Réinitialiser</a>
            </form>
        </section>

        <section class="grille">

            {% for livre in livres %}
                <article class="carte">
                    <a href="#" class="carte-couverture">
                        <img src="{{livre.image}}" alt="1984">
                        <span class="badge badge-disponible">2 / 3 disponibles</span>
                    </a>
                    <div class="carte-contenu">
                        <span class="genre">{{livre.genre}}</span>
                        <h2 class="carte-titre">{{livre.titre}}</h2>
                        <p class="carte-auteur">{{livre.auteur}}</p>
                        <div class="carte-bas">
                            <span class="carte-annee">{{livre.annee}}</span>
                            <a href="#" class="bouton bouton-petit">Voir</a>
                        </div>
                    </div>
                </article>
                {% endfor %}
        </section>

    </main>
{% endblock %}
